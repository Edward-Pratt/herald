# herald's updater check: says on the desktop when a newer release is ready. Installed by the project's install script
# as ~/.config/systemd/user/PROJECT-update.service, with PROJECT replaced by the project's name.
[Unit]
Description=Check for a newer PROJECT release

[Service]
Type=oneshot
Environment=HERALD_NOTIFY=1
ExecStart=%h/.local/bin/PROJECT-update --check
